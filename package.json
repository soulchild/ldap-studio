{
  "name": "ldap-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, modern LDAP directory browser and editor",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:env:up": "sh test/ldap/up.sh",
    "test:env:check": "node test/ldap/check.mjs",
    "test:env:down": "docker compose -f test/ldap/docker-compose.yml down -v",
    "test:env:verify": "node test/ldap/verify-seed.mjs",
    "test:integration": "vitest run --project integration",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "changelog:preview": "git-cliff --unreleased --strip header"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "ldapts": "9.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.23",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "git-cliff": "2.14.2",
    "globals": "17.13.0",
    "lucide-react": "1.62.0",
    "prettier": "3.9.10",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "author": "LDAP Studio"
}
